{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ESNext"
		],
		"allowJs": false,
		"skipLibCheck": true,
		"esModuleInterop": false,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"module": "ESNext",
		"moduleResolution": "Node",
		"resolveJsonModule": true,
		// "noEmit": true,
		"declaration": true,
		// "emitDeclarationOnly": true,
		"noEmitOnError": false,
		"paths": {

		},
		"typeRoots": [
			"node_modules/@types",
			"types"
		]
	},
	"include": [
		"src",
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
