#!/usr/bin/env sh

# Git GUI clients often use a minimal PATH without node/pnpm.
if ! command -v node >/dev/null 2>&1; then
	export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
	[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
fi
export PATH="$HOME/Library/pnpm:/opt/homebrew/bin:/usr/local/bin:$PATH"

MAGIC_WEB_DIR="$(cd "$(dirname -- "$0")/.." && pwd)"
cd "$MAGIC_WEB_DIR"

. "$MAGIC_WEB_DIR/.husky/node-env.sh"

# add emoji to your commit
filepath="$1"
tmp_file=$(mktemp /tmp/emoji-commitzen.XXXX)

replacements=(
    's/^feat/✨ feat/'
    's/^version/🔖 version/'
    's/^fix/🐛 fix/'
    's/^doc/📚 doc/'
    's/^docs/📚 docs/'
    's/^style/💄 style/'
    's/^refactor/🔨 refactor/'
    's/^perf/🚀 perf/'
    's/^chore/🔧 chore/'
    's/^lint/🚨 lint/'
    's/^test/✅ test/'
    's/^build/👷 build/'
    's/^ci/💚 ci/'
    's/^revert/⏪ revert/'
    's/^release/🎉 release/'
    's/^config/🔧 config/'
    's/^remove/🗑 remove/'
    's/^typo/✏️ typo/'
)

sed_command=$(printf "%s;" "${replacements[@]}")
sed "$sed_command" "$filepath" > "$tmp_file"
mv "$tmp_file" "$filepath"

# your custom logic

pnpm exec commitlint --edit "$1"
