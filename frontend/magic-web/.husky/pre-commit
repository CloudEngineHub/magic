# Resolve the magic-web project root from this hook's location.
# Works both in the monorepo (git root != project root) and when
# magic-web is distributed as a standalone repository.
MAGIC_WEB_DIR="$(cd "$(dirname -- "$0")/.." && pwd)"
cd "$MAGIC_WEB_DIR"

. "$MAGIC_WEB_DIR/.husky/node-env.sh"

# Prevent enterprise changes from being silently hidden by customer overrides.
echo "🧩 Checking overlay synchronization..."
if ! node scripts/git-hooks/check-overlay-sync.cjs; then
	exit 1
fi

# Check for hardcoded tokens
echo "🔍 Checking for hardcoded tokens..."
if ! node scripts/git-hooks/check-hardcoded-tokens.cjs; then
	exit 1
fi

# Block commits when OKLCH and RGB tokens drift.
echo "🎨 Checking theme RGB tokens..."
if ! pnpm generate:theme-rgb-tokens:check; then
	exit 1
fi

# Run lint-staged for code formatting
NODE_OPTIONS="--max-old-space-size=8192" pnpm exec lint-staged
