{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"baseUrl": ".",
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2020",
		"types": ["vitest/globals", "node"]
	},
	"exclude": ["dist", "node_modules"],
	"include": ["src/**/*", "tests/**/*", "vitest.config.ts", "vite.config.ts"]
}
