{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letsmagic.cn/schemas/slide-template/template-json.schema.json",
  "title": "Slide Template Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "name", "files", "slides", "source", "warnings"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "template_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "name": { "type": "string" },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_spec", "theme_css", "slides_dir", "images_dir", "package_zip"],
      "properties": {
        "visual_spec": { "type": "string" },
        "theme_css": { "type": "string" },
        "slides_dir": { "type": "string" },
        "images_dir": { "type": "string" },
        "package_zip": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "items": { "$ref": "#/$defs/templateSlide" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file", "canvas"],
      "properties": {
        "kind": { "type": "string", "enum": ["original", "pptx_import", "project_extract"] },
        "file": { "type": "string" },
        "canvas": { "type": "object" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "templateSlide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "title", "layout", "source_slide", "slots", "best_for", "risks"],
      "properties": {
        "file": { "type": "string" },
        "title": { "type": "string" },
        "layout": { "type": "string" },
        "source_slide": { "type": "integer" },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/templateSlot" }
        },
        "best_for": { "type": "string" },
        "risks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "templateSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "role", "sample"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "chart"] },
        "role": { "type": "string" },
        "sample": { "type": "string" }
      }
    }
  }
}
