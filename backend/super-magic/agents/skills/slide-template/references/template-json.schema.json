{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTML Slide Template Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "label",
    "description",
    "files",
    "slides",
    "source",
    "warnings"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "template_id": { "type": "string", "pattern": "^PPT-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "category_code": { "type": "string", "pattern": "^PPT-CATE-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh_CN", "en_US"],
      "properties": {
        "zh_CN": { "type": "string", "minLength": 1 },
        "en_US": { "type": "string", "minLength": 1 }
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh_CN", "en_US"],
      "properties": {
        "zh_CN": { "type": "string", "minLength": 1 },
        "en_US": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme_css", "slides_dir", "images_dir"],
      "properties": {
        "visual_spec": { "type": "string" },
        "theme_css": { "type": "string" },
        "slides_dir": { "type": "string" },
        "images_dir": { "type": "string" },
        "package_zip": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "title", "layout", "description"],
        "properties": {
          "file": { "type": "string", "pattern": "^slides/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.html$" },
          "title": { "type": "string", "minLength": 1 },
          "layout": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file", "canvas"],
      "properties": {
        "kind": { "type": "string", "enum": ["original", "converted", "derived"] },
        "file": { "type": "string" },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "const": 1920 },
            "height": { "type": "integer", "const": 1080 }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
